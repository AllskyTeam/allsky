                            "checkchanges": true,
                            "step": "1",
                            "unit": "days",
                            "metadata": {
                                "depends": {
                                    "booldependson": "uselocalwebsite"
                                },
                                "level": "beginner"
                            }
                        }
                    }
                },
                "remotewebsite": {
                    "label": "Remote Website",
                    "settings": {
                        "useremotewebsite": {
                            "default": false,
