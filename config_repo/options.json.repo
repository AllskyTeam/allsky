{
    "sections": {
        "daynight": {
            "sections": {
                "daytimesettings": {
                    "label": "Daytime",
                    "settings": {
                        "takedaytimeimages": {
                            "default": true,
                            "description": "Enable to <strong>take</strong> daytime images.",
                            "label": "Capture",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "beginner"
                            }
                        },
                        "savedaytimeimages": {
                            "default": false,
                            "description": "Enable to <strong>save</strong> daytime images.",
                            "label": "Save",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "dayautoexposure": {
                            "default": true,
                            "description": "Enable to use daytime auto-exposure.",
                            "label": "Auto-Exposure",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "dayauto",
                                    "groupname": "Daytime Auto Exposure",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "daymaxautoexposure": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Maximum daytime <span class='WebUISetting'>Auto-Exposure</span> time in milliseconds (1000ms = 1 sec).<br>Click <a external='true' href='/docs/allsky_guide/settings/allsky.html#daymaxautoexposure'>here</a> to see how this setting impacts the time between exposures.",
                            "label": "Max Auto-Exposure",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "unit": "ms",
                            "metadata": {
                                "layout": {
                                    "group": "dayauto"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayautoexposure"
                                },
                                "level": "beginner"
                            }
                        },
                        "dayexposure": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "day_default",
                            "description": "Manual exposure time in milliseconds (1000ms = 1 sec). Can be a fraction.<br>If daytime <span class='WebUISetting'>Auto-Exposure</span> is enabled, this number is used as a starting point.<br>Click <a external='true' href='/docs/allsky_guide/settings/allsky.html#dayexposure'>here</a> to see how this setting impacts the time between exposures.",
                            "label": "Manual Exposure",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "unit": "ms",
                            "metadata": {
                                "layout": {
                                    "group": "dayauto"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "dayautogain": {
                            "default": "day_default",
                            "description": "Enable to use dayime auto-gain.",
                            "label": "Auto-Gain",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "daygain",
                                    "groupname": "Daytime Gain",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "daymaxautogain": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Maximum gain when <span class='WebUISetting'>Auto-Gain</span> is enabled.",
                            "label": "Max Auto-Gain",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "metadata": {
                                "layout": {
                                    "group": "daygain"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayautogain"
                                },
                                "level": "beginner"
                            }
                        },
                        "daygain": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "day_default",
                            "description": "Manually sets the light sensitivity of the camera.<br>A high number returns a brighter image but more noise. Can normally leave at the minimum value for daytime.",
                            "label": "Gain",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "metadata": {
                                "layout": {
                                    "group": "daygain"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "daymean": {
                            "minimum": 0.0,
                            "maximum": 1.0,
                            "default": "day_default",
                            "description": "The target mean brightness level when <span class='WebUISetting'>Auto-Exposure</span> is on. <span class='WebUIValue'>1.0</span> is pure white.<br>Best used when <span class='WebUISetting'>Auto-Exposure</span> and <span class='WebUISetting'>Auto-Gain</span> are on.<br><span class='WebUIValue'>0</span> disables this auto-exposure mode.",
                            "label": "Mean Target",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "metadata": {
                                "layout": {
                                    "group": "daygain"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "daymeanthreshold": {
                            "minimum": "day_min",
                            "maximum": "day_max",
                            "default": "day_default",
                            "description": "When using <span class='WebUISetting'>Mean Target</span> this specifies how close to the target the brightness should be.",
                            "label": "Mean Threshold",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "metadata": {
                                "layout": {
                                    "group": "daygain"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages AND daymean"
                                },
                                "level": "advanced"
                            }
                        },
                        "dayawb": {
                            "display": "_display",
                            "default": false,
                            "description": "Sets auto white balance so the camera adjusts the color.",
                            "label": "Auto White Balance",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "daywhitebalance",
                                    "groupname": "Daytime White Balance",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "daywbr": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Red component for the white balance.<br>When <span class='WebUISetting'>Auto White Balance</span> is enabled, this number is a starting point.",
                            "label": "Red Balance",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "daywhitebalance"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayawb"
                                },
                                "level": "beginner"
                            }
                        },
                        "daywbb": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Blue component for the white balance.<br>When <span class='WebUISetting'>Auto White Balance</span> is enabled, this number is a starting point.",
                            "label": "Blue Balance",
                            "label_prefix": "Daytime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "daywhitebalance"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayawb"
                                },
                                "level": "beginner"
                            }
                        },
                        "imagestretchamountdaytime": {
                            "minimum": 0,
                            "maximum": 100,
                            "default": 0,
                            "description": "Amount to stretch daytime images.  <span class='WebUIValue'>0</span> means don't stretch.",
                            "label": "Stretch Amount",
                            "label_prefix": "Daytime",
                            "type": "integer",
                            "step": "1",
                            "metadata": {
                                "layout": {
                                    "group": "daystretch",
                                    "groupname": "Daytime Image Stretch"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "imagestretchmidpointdaytime": {
                            "minimum": 1,
                            "maximum": 100,
                            "default": 10,
                            "description": "Mid point of image stretch.<br>Lower numbers brighten darker parts of image; higher numbers brighten lighter parts.<br>Only applies if <span class='WebUISetting'>Stretch Amount</span> is greater than 0.",
                            "label": "Stretch Mid Point",
                            "label_prefix": "Daytime",
                            "type": "percent",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "daystretch"
                                },
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "daydelay": {
                            "minimum": "_min",
                            "maximum": "none",
                            "default": 30000,
                            "description": "Delay between daytime images in milliseconds (1000ms = 1 sec).",
                            "label": "Delay",
                            "label_prefix": "Daytime",
                            "type": "integer",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "step": "1",
                            "unit": "ms",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "daybin": {
                            "default": 1,
                            "description": "Binning level. <span class='WebUIValue'>1x1</span> = OFF.",
                            "label": "Binning",
                            "label_prefix": "Daytime",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                "bin_values"
                            ],
                            "action": "reload",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "dayskipframes": {
                            "minimum": 0,
                            "maximum": "none",
                            "default": 5,
                            "description": "When starting Allsky during the day, skip up to this many frames while the software gets to the correct exposure.",
                            "label": "Frames To Skip",
                            "label_prefix": "Daytime",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "unit": "frames",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayautoexposure"
                                },
                                "level": "advanced"
                            }
                        },
                        "dayenablecooler": {
                            "display": "_display",
                            "default": false,
                            "description": "Enable to use cooling (on cooled cameras only).",
                            "label": "Cooling",
                            "label_prefix": "Daytime",
                            "type": "boolean",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "daytargettemp": {
                            "display": "_display",
                            "description": "Sensor's target temperature <i>when cooler is enabled</i> (degrees Celsius).",
                            "label": "Target Temp.",
                            "label_prefix": "Daytime",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages AND dayenablecooler"
                                },
                                "level": "advanced"
                            },
                            "maximum": "_max",
                            "default": "_default",
                            "minimum": "_min"
                        },
                        "daytuningfile": {
                            "display": "_display",
                            "default": "",
                            "description": "Name of the optional day camera tuning file to use.<br>See the documentation for a <a external='true' href='/docs/allsky_guide/settings/allsky.html#daytuningfile'>description of this setting</a>.",
                            "label": "Tuning File",
                            "label_prefix": "Daytime",
                            "type": "widetext",
                            "usage": "capture",
                            "checkchanges": true,
                            "optional": true,
                            "action": "restart",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takedaytimeimages"
                                },
                                "level": "beginner"
                            }
                        }
                    }
                },
                "nighttimesettings": {
                    "label": "Nighttime",
                    "settings": {
                        "takenighttimeimages": {
                            "default": true,
                            "description": "Enable to <strong>take</strong> nighttime images.",
                            "label": "Capture",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "beginner"
                            }
                        },
                        "savenighttimeimages": {
                            "default": true,
                            "description": "Enable to <strong>save</strong> nighttime images.",
                            "label": "Save",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightautoexposure": {
                            "default": true,
                            "description": "Enable to use nighttime auto-exposure.",
                            "label": "Auto-Exposure",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "nightauto",
                                    "groupname": "Nighttime Auto Exposure",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightmaxautoexposure": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Maximum nighttime <span class='WebUISetting'>Auto-Exposure</span> time in milliseconds (1000ms = 1 sec).",
                            "label": "Max Auto-Exposure",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "unit": "ms",
                            "metadata": {
                                "layout": {
                                    "group": "nightauto"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightautoexposure"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightexposure": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "night_default",
                            "description": "Manual exposure time in milliseconds (1000ms = 1 sec). Can be a fraction.<br>If nighttime <span class='WebUISetting'>Auto-Exposure</span> is enabled, this number is used as a starting point.",
                            "label": "Manual Exposure",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "unit": "ms",
                            "metadata": {
                                "layout": {
                                    "group": "nightauto"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightautogain": {
                            "default": "night_default",
                            "description": "Enable to use nighttime auto-gain.",
                            "label": "Auto-Gain",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "nightgain",
                                    "groupname": "Nighttime Gain",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightmaxautogain": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Maximum gain when <span class='WebUISetting'>Auto-Gain</span> is enabled.",
                            "label": "Max Auto-Gain",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "metadata": {
                                "layout": {
                                    "group": "nightgain"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightautogain"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightgain": {
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "night_default",
                            "description": "Manually sets the light sensitivity of the camera.<br>A high number returns a brighter image but more noise.",
                            "label": "Gain",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.001",
                            "metadata": {
                                "layout": {
                                    "group": "nightgain"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightautogain"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightmean": {
                            "minimum": 0.0,
                            "maximum": 1.0,
                            "default": "night_default",
                            "description": "The target mean brightness level when <span class='WebUISetting'>Auto-Exposure</span> is on. <span class='WebUIValue'>1.0</span> is pure white.<br>Best used when <span class='WebUISetting'>Auto-Exposure</span> and <span class='WebUISetting'>Auto-Gain</span> are on.<br><span class='WebUIValue'>0</span> disables this auto-exposure mode.",
                            "label": "Mean Target",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "metadata": {
                                "layout": {
                                    "group": "nightgain"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "nightmeanthreshold": {
                            "minimum": "night_min",
                            "maximum": "night_max",
                            "default": "day_default",
                            "description": "When using <span class='WebUISetting'>Mean Target</span> this specifies how close to the target the brightness should be.",
                            "label": "Mean Threshold",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.01",
                            "metadata": {
                                "layout": {
                                    "group": "nightgain"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightmean"
                                },
                                "level": "advanced"
                            }
                        },
                        "nightawb": {
                            "display": "_display",
                            "default": false,
                            "description": "Enable to use auto white balance so the camera adjusts the color.<br>NOTE: enabling this can <strong>significantly</strong> increase the time needed to capture a nighttime image, so it's usually best to disable this at night.",
                            "label": "Auto White Balance",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "layout": {
                                    "group": "nightwhitebalance",
                                    "groupname": "Nighttime White Balance",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "nightwbr": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Red component for the white balance.<br>When <span class='WebUISetting'>Auto White Balance</span> is enabled, this number is a starting point.",
                            "label": "Red Balance",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "nightwhitebalance"
                                },
                                "depends": {
                                    "booldependsoff": "nightawb",
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "nightwbb": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Blue component for the white balance.<br>When <span class='WebUISetting'>Auto White Balance</span> is enabled, this number is a starting point.",
                            "label": "Blue Balance",
                            "label_prefix": "Nighttime",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "nightwhitebalance"
                                },
                                "depends": {
                                    "booldependsoff": "nightawb",
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "imagestretchmoon": {
                            "default": false,
                            "description": "Change the nighttime stretch with the moonlight.<br>When on, the <span class='WebUISetting'>Stretch Amount</span> and <span class='WebUISetting'>Stretch mid point</span> above are used when there's no moonlight (new Moon, or the Moon below the horizon), and the two <span class='WebUISetting'>Full Moon</span> settings below when a full Moon is high in the sky. In between, the values are interpolated by how bright the Moon is and how high it is.",
                            "label": "Moon-dependent stretch",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "metadata": {
                                "layout": {
                                    "group": "nightstretch",
                                    "groupname": "Nighttime Image Stretch",
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "imagestretchamountfullmoon": {
                            "minimum": 0,
                            "maximum": 100,
                            "default": 0,
                            "description": "Amount to stretch nighttime images when a full Moon is high in the sky.  <span class='WebUIValue'>0</span> means don't stretch.<br>Usually lower than the <span class='WebUISetting'>Stretch Amount</span> above, since moonlight already brightens the sky.",
                            "label": "Full Moon Stretch Amount",
                            "label_prefix": "Nighttime",
                            "type": "integer",
                            "step": "1",
                            "metadata": {
                                "layout": {
                                    "group": "nightstretch"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND imagestretchmoon"
                                },
                                "level": "advanced"
                            }
                        },
                        "imagestretchmidpointfullmoon": {
                            "minimum": 1,
                            "maximum": 100,
                            "default": 10,
                            "description": "Mid point of the image stretch when a full Moon is high in the sky.<br>Lower numbers brighten darker parts of image; higher numbers brighten lighter parts.",
                            "label": "Full Moon Stretch mid point",
                            "label_prefix": "Nighttime",
                            "type": "percent",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "nightstretch"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages AND imagestretchmoon"
                                },
                                "level": "advanced"
                            }
                        },
                        "imagestretchamountnighttime": {
                            "minimum": 0,
                            "maximum": 100,
                            "default": 0,
                            "description": "Amount to stretch nighttime images.  <span class='WebUIValue'>0</span> means don't stretch.",
                            "label": "Stretch Amount",
                            "label_prefix": "Nighttime",
                            "type": "integer",
                            "step": "1",
                            "metadata": {
                                "layout": {
                                    "group": "nightstretch",
                                    "groupname": "Nighttime Image Stretch"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "imagestretchmidpointnighttime": {
                            "minimum": 1,
                            "maximum": 100,
                            "default": 10,
                            "description": "Mid point of image stretch.<br>Lower numbers brighten darker parts of image; higher numbers brighten lighter parts.<br>Only applies if <span class='WebUISetting'>Stretch Amount</span> is greater than 0.",
                            "label": "Stretch mid point",
                            "label_prefix": "Nighttime",
                            "type": "percent",
                            "step": "0.1",
                            "metadata": {
                                "layout": {
                                    "group": "nightstretch",
                                    "groupname": "Nighttime Image Stretch"
                                },
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightdelay": {
                            "minimum": "_min",
                            "maximum": "none",
                            "default": 30000,
                            "description": "Delay between nighttime images in milliseconds (1000ms = 1 sec).",
                            "label": "Delay",
                            "label_prefix": "Nighttime",
                            "type": "integer",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "step": "1",
                            "unit": "ms",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightbin": {
                            "default": 1,
                            "description": "Binning level. <span class='WebUIValue'>1x1</span> = OFF.",
                            "label": "Binning",
                            "label_prefix": "Nighttime",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                "bin_values"
                            ],
                            "action": "reload",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nightskipframes": {
                            "minimum": 0,
                            "maximum": "none",
                            "default": 1,
                            "description": "When starting Allsky at night, skip up to this many frames while the software gets to the correct exposure.",
                            "label": "Frames To Skip",
                            "label_prefix": "Nighttime",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "unit": "frames",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightautoexposure"
                                },
                                "level": "advanced"
                            }
                        },
                        "nightenablecooler": {
                            "display": "_display",
                            "default": false,
                            "description": "Enable to use cooling (on cooled cameras only).",
                            "label": "Cooling",
                            "label_prefix": "Nighttime",
                            "type": "boolean",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "nighttargettemp": {
                            "display": "_display",
                            "description": "Sensor's target temperature <i>when cooler is enabled</i> (degrees Celsius).",
                            "label": "Target Temp.",
                            "label_prefix": "Nighttime",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages AND nightenablecooler"
                                },
                                "level": "beginner"
                            },
                            "maximum": "_max",
                            "default": "_default",
                            "minimum": "_min"
                        },
                        "nighttuningfile": {
                            "display": "_display",
                            "default": "",
                            "description": "Name of the night camera tuning file to use.",
                            "label": "Tuning File",
                            "label_prefix": "Nighttime",
                            "type": "widetext",
                            "usage": "capture",
                            "checkchanges": true,
                            "optional": true,
                            "action": "restart",
                            "metadata": {
                                "depends": {
                                    "booldependson": "takenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        }
                    }
                },
                "dayandnight": {
                    "label": "Both",
                    "settings": {
                        "daystokeep": {
                            "minimum": 0,
                            "maximum": 9999,
                            "step": 1,
                            "default": 14,
                            "description": "Number of days of images and videos to keep on the Pi. <span class='WebUIValue'>0</span> keeps all days.",
                            "label": "Days To Keep",
                            "type": "daystokeep",
                            "carryforward": true,
                            "checkchanges": true,
                            "unit": "days",
                            "metadata": {
                                "depends": {
                                    "booldependson": "savedaytimeimages OR savenighttimeimages"
                                },
                                "level": "beginner"
                            }
                        },
                        "config": {
                            "default": "[none]",
                            "description": "Configuration file to use for settings.",
                            "label": "Configuration File",
                            "type": "widetext",
                            "usage": "capture",
                            "checkchanges": true,
                            "optional": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "extraargs": {
                            "display": "_display",
                            "default": "",
                            "description": "Extra arguments to pass to the capture program that Allsky doesn't support.",
                            "label": "Extra Arguments",
                            "type": "widetext",
                            "usage": "capture",
                            "optional": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "saturation": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Changes the saturation level of the image.<br>The lowest level produces a black and white image.",
                            "label": "Saturation",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "contrast": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Changes the contrast of an image.",
                            "label": "Contrast",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "sharpness": {
                            "display": "_display",
                            "minimum": "_min",
                            "maximum": "_max",
                            "default": "_default",
                            "description": "Changes the sharpness of an image.<br>Too sharp and images look unnatural.",
                            "label": "Sharpness",
                            "type": "float",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "aggression": {
                            "display": "_display",
                            "description": "How much of a calculated exposure change should be made during auto-exposure?<br>Lower numbers smooth out changes but take longer to react to brightness changes.",
                            "label": "Aggression",
                            "type": "percent",
                            "usage": "capture",
                            "action": "reload",
                            "step": "0.1",
                            "metadata": {
                                "depends": {
                                    "booldependson": "dayautoexposure OR nightautoexposure"
                                },
                                "level": "advanced"
                            },
                            "maximum": "_max",
                            "default": "_default",
                            "minimum": "_min"
                        },
                        "gaintransitiontime": {
                            "display": "_display",
                            "minimum": 0,
                            "maximum": "none",
                            "description": "Number of <b>minutes</b> over which to increase or decrease the gain when switching between day and night.<br>This helps smooth brightness differences. <span class='WebUIValue'>0</span> disables transitions.",
                            "label": "Gain Transition Time",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "metadata": {
                                "depends": {
                                    "booldependsoff": "nightautogain"
                                },
                                "level": "advanced"
                            },
                            "default": "_default"
                        },
                        "type": {
                            "default": 99,
                            "description": "'auto' uses color if possible, otherwise the best mono mode supported.<br>RAW16 only works with PNG extension.",
                            "label": "Image Type",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                "type_values"
                            ],
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "quality": {
                            "minimum": 1,
                            "maximum": 100,
                            "default": 95,
                            "description": "JPG quality: 0-100. Higher numbers produce larger, clearer files.<br>PNG compression: 0-9. Higher numbers produce smaller files but take longer to save.",
                            "label": "Quality / Compression",
                            "type": "integer",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "step": "1",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "autousb": {
                            "display": "_display",
                            "default": true,
                            "description": "Automatically set the USB bandwidth.",
                            "label": "Auto USB Bandwidth",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "usb": {
                            "display": "_display",
                            "description": "USB bandwidth.<br>If you get ASI_ERROR_TIMEOUT errors in the log file, try changing this number up and/or down.",
                            "label": "USB Bandwidth",
                            "type": "integer",
                            "usage": "capture",
                            "action": "reload",
                            "step": "1",
                            "metadata": {
                                "depends": {
                                    "booldependsoff": "autousb"
                                },
                                "level": "advanced"
                            },
                            "maximum": "_max",
                            "default": "_default",
                            "minimum": "_min"
                        },
                        "filename": {
                            "default": "image.jpg",
                            "description": "Extensions allowed: .jpg or .png.<br><b>WARNING</b>: saving a .png file can take 10 or more seconds so be sure the time between successive images is long enough.  To measure how long it takes your Pi to save a .png file, set the <span class='WebUISetting'>Debug Level</span> to 4 and look in the log file.",
                            "label": "Filename",
                            "type": "text",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "beginner"
                            }
                        },
                        "rotation": {
                            "display": "_display",
                            "default": 0,
                            "description": "Set image rotation to enable proper orientation.",
                            "label": "Rotation",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                "rotation_values"
                            ],
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "flip": {
                            "default": 0,
                            "description": "Flips the image along an axis.",
                            "label": "Flip",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                {
                                    "value": 0,
                                    "label": "None"
                                },
                                {
                                    "value": 1,
                                    "label": "Horizontal"
                                },
                                {
                                    "value": 2,
                                    "label": "Vertical"
                                },
                                {
                                    "value": 3,
                                    "label": "Both"
                                }
                            ],
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "determinefocus": {
                            "default": false,
                            "description": "Enable to have the image focus determined and output via the 'FOCUS' variable.",
                            "label": "Record Focus",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "focusmode": {
                            "default": false,
                            "description": "Enable enter focus mode.",
                            "label": "Focus Mode",
                            "type": "boolean",
                            "usage": "capture",
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "consistentdelays": {
                            "default": true,
                            "description": "Enable to have the delays between images be a consistent length.<br>The time between the start of exposures will always be <span class='WebUISetting'>Max Auto-Exposure + Delay</span>.",
                            "label": "Consistent Delays Between Images",
                            "type": "boolean",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "timeformat": {
                            "default": "%Y%m%d %H:%M:%S",
                            "description": "Determines the format of the displayed date and time. Run <code>man 3 strftime</code> to see the options.",
                            "label": "Time Format",
                            "type": "timeformat",
                            "usage": "capture",
                            "carryforward": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "temptype": {
                            "default": "C",
                            "description": "Unit(s) to display temperature in.",
                            "label": "Temperature Units",
                            "type": "select_text",
                            "usage": "capture",
                            "carryforward": true,
                            "options": [
                                {
                                    "value": "C",
                                    "label": "Celsius"
                                },
                                {
                                    "value": "F",
                                    "label": "Fahrenheit"
                                },
                                {
                                    "value": "B",
                                    "label": "Both"
                                }
                            ],
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "latitude": {
                            "default": "",
                            "description": "Camera latitude: a signed number from <span class='WebUIValue'>-90</span> to <span class='WebUIValue'>+90</span>, or an unsigned number with direction (N or S), for example: <span class='WebUIValue'>60.7N</span>.",
                            "label": "Latitude",
                            "type": "latitude",
                            "longitudefield": "longitude",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "beginner"
                            }
                        },
                        "longitude": {
                            "default": "",
                            "description": "Camera longitude: a signed number from <span class='WebUIValue'>-180</span> to <span class='WebUIValue'>+180</span>, or an unsigned number with a direction (E or W), for example: <span class='WebUIValue'>135.05W</span>.",
                            "label": "Longitude",
                            "type": "longitude",
                            "latitudefield": "latitude",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "beginner"
                            }
                        },
                        "angle": {
                            "default": -6.0,
                            "description": "Altitude of the Sun in degrees relative to the horizon at which to switch between day and night.",
                            "label": "Angle",
                            "type": "sunangle",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "minimum": -90.0,
                            "maximum": 90.0,
                            "step": "0.01",
                            "unit": "°",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "takedarkframes": {
                            "default": false,
                            "description": "Enable to capture dark frames, which are used to decrease noise.<br>See the <a external='true' href='/docs/allsky_guide/howtos/dark_frames.html#howtousedarks'>Dark frames</a> documentation on how to take dark frames.",
                            "label": "Take Dark Frames",
                            "type": "boolean",
                            "usage": "capture",
                            "action": "stop",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "imageremovebadhighdarkframe": {
                            "default": 0.05,
                            "description": "Ignore dark frames brighter than this.",
                            "label": "Remove Bad Darks Threshold High",
                            "type": "float",
                            "usage": "capture",
                            "checkchanges": true,
                            "action": "reload",
                            "step": "0.01",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "usedarkframes": {
                            "default": false,
                            "description": "Enables dark frame subtraction if you have dark frames.",
                            "label": "Use Dark Frames",
                            "type": "boolean",
                            "checkchanges": true,
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "locale": {
                            "default": "",
                            "description": "Your locale, used to determine what the thousands and decimal separators are.<br>Choose from the locales available on your Pi. Saving an uninstalled locale enables it; reboot the Pi afterwards.",
                            "label": "Locale",
                            "type": "locale",
                            "usage": "capture",
                            "carryforward": true,
                            "checkchanges": true,
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "zwoexposuretype": {
                            "display": "_display",
                            "default": 0,
                            "description": "Select the type of exposure to use with ZWO cameras.  Use <span class='WebUIValue'>Snapshot</span> if possible since it should fix ASI_ERROR_TIMEOUT problems.  If that doesn't work try <span class='WebUIValue'>Video Off</span>. Note that <span class='WebUISetting'>Auto White Balance</span> does not work in <span class='WebUIValue'>Snapshot</span>",
                            "label": "ZWO Exposure Type",
                            "type": "select_integer",
                            "usage": "capture",
                            "options": [
                                {
                                    "value": 0,
                                    "label": "Snapshot"
                                },
                                {
                                    "value": 1,
                                    "label": "Video Off"
                                },
                                {
                                    "value": 2,
                                    "label": "Video (original)"
                                }
                            ],
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        },
                        "histogrambox": {
                            "display": "_display",
                            "default": "500 500 50 50",
                            "description": "Size of the histogram box (X and Y in pixels) and offset from left and top (0-100 percent). Sizes must be even numbers.",
                            "label": "Histogram Box",
                            "type": "text",
                            "usage": "capture",
                            "action": "reload",
                            "metadata": {
                                "depends": {
                                    "booldependson": "dayautoexposure OR nightautoexposure"
                                },
                                "level": "advanced"
                            }
                        },
                        "debuglevel": {
                            "default": 1,
                            "description": "Debug level. Use <span class='WebUIValue'>3</span> while debugging.  See the <a external='true' href='/docs/allsky_guide/settings/allsky.html#debuglevel'>documentation</a> for meaning of the levels.",
                            "label": "Debug Level",
                            "type": "select_integer",
                            "usage": "capture",
                            "carryforward": true,
                            "options": [
                                {
                                    "value": 0,
                                    "label": 0
                                },
                                {
                                    "value": 1,
                                    "label": 1
                                },
                                {
                                    "value": 2,
                                    "label": 2
                                },
                                {
                                    "value": 3,
                                    "label": 3
                                },
                                {
                                    "value": 4,
                                    "label": 4
                                },
                                {
                                    "value": 5,
                                    "label": 5
                                }
                            ],
                            "action": "reload",
                            "metadata": {
                                "level": "advanced"
                            }
                        }
                    }
                }
            },
            "label": "Day/Night Settings"
        },
        "postcapture": {
            "label": "Post Capture",
            "settings": {
                "imageremovebadlow": {
                    "minimum": 0,
                    "maximum": 0.5,
                    "default": 0.1,
                    "description": "Delete images whose mean is below this value.<br><span class='WebUIValue'>0</span> disables this check.",
                    "label": "Remove Bad Images Threshold Low",
                    "type": "float",
                    "usage": "capture",
                    "action": "restart",
                    "step": "0.01",
                    "metadata": {
                        "layout": {
                            "group": "imagebad",
                            "groupname": "Bad Image Removal"
                        },
                        "depends": {
                            "booldependson": "savedaytimeimages OR savenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imageremovebadhigh": {
                    "minimum": 0,
                    "maximum": 0.999,
                    "default": 0.9,
                    "description": "Delete images whose mean is above this value.<br><span class='WebUIValue'>0</span> disables this check.",
                    "label": "Remove Bad Images Threshold High",
                    "type": "float",
                    "usage": "capture",
                    "action": "restart",
                    "step": "0.001",
                    "metadata": {
                        "layout": {
                            "group": "imagebad"
                        },
                        "depends": {
                            "booldependson": "savedaytimeimages OR savenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imageremovebadcount": {
                    "default": 5,
                    "description": "After this many 'bad' images display a message.",
                    "label": "Remove Bad Images Threshold Count",
                    "type": "integer",
                    "usage": "capture",
                    "action": "restart",
                    "step": "1",
                    "metadata": {
                        "layout": {
                            "group": "imagebad"
                        },
                        "level": "advanced"
                    }
                },
                "imagecreatethumbnails": {
                    "default": true,
                    "description": "Enable to create thumbnails of images. If you never look at them, disable this.",
                    "label": "Create Image Thumbnails",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "layout": {
                            "group": "thumbnails",
                            "singlerow": true
                        },
                        "depends": {
                            "booldependson": "savedaytimeimages OR savenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "thumbnailsizex": {
                    "minimum": 25,
                    "maximum": "500",
                    "default": 100,
                    "description": "Width of image and video thumbnails.",
                    "label": "Thumbnail Width",
                    "type": "integer",
                    "carryforward": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "thumbnails"
                        },
                        "depends": {
                            "booldependson": "savedaytimeimages AND imagecreatethumbnails OR savenighttimeimages AND imagecreatethumbnails"
                        },
                        "level": "advanced"
                    }
                },
                "thumbnailsizey": {
                    "minimum": 20,
                    "maximum": "400",
                    "default": 75,
                    "description": "Height of image and video thumbnails.",
                    "label": "Thumbnail Height",
                    "type": "integer",
                    "carryforward": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "thumbnails"
                        },
                        "depends": {
                            "booldependson": "savedaytimeimages AND imagecreatethumbnails OR savenighttimeimages AND imagecreatethumbnails"
                        },
                        "level": "advanced"
                    }
                },
                "imageresizewidth": {
                    "minimum": 0,
                    "maximum": "none",
                    "default": 0,
                    "description": "Width of resized image before cropping.  <span class='WebUIValue'>0</span> means don't resize.  Must be an even number.",
                    "label": "Image Resize Width",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imageresize",
                            "groupname": "Image Resize"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imageresizeheight": {
                    "minimum": 0,
                    "maximum": "none",
                    "default": 0,
                    "description": "Height of resized image before cropping.  <span class='WebUIValue'>0</span> means don't resize.  Must be an even number.",
                    "label": "Image Resize Height",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imageresize"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imagecroptop": {
                    "minimum": 0,
                    "maximum": "_max",
                    "default": 0,
                    "description": "Number of pixels to crop off the top of image.",
                    "label": "Image Crop Top",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imagecrop",
                            "groupname": "Image Cropping"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imagecropright": {
                    "minimum": 0,
                    "maximum": "_max",
                    "default": 0,
                    "description": "Number of pixels to crop off the right side of image.",
                    "label": "Image Crop Right",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imagecrop"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imagecropbottom": {
                    "minimum": 0,
                    "maximum": "_max",
                    "default": 0,
                    "description": "Number of pixels to crop off the bottom of image.",
                    "label": "Image Crop Bottom",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imagecrop"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                },
                "imagecropleft": {
                    "minimum": 0,
                    "maximum": "_max",
                    "default": 0,
                    "description": "Number of pixels to crop off the left side of image.",
                    "label": "Image Crop Left",
                    "type": "integer",
                    "checkchanges": true,
                    "step": "1",
                    "unit": "px",
                    "metadata": {
                        "layout": {
                            "group": "imagecrop"
                        },
                        "depends": {
                            "booldependson": "takedaytimeimages OR takenighttimeimages"
                        },
                        "level": "advanced"
                    }
                }
            }
        },
        "timelapse": {
            "sections": {
                "timelapsesub": {
                    "label": "Daily",
                    "settings": {
                        "timelapsegenerate": {
                            "default": true,
                            "description": "Enable to generate a timelapse video at the end of night.<br>See the <span class='settingsHeader'>Websites and Remote Server Settings</span> section for upload settings.",
                            "label": "Generate",
                            "label_prefix": "Daily Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "layout": {
                                    "singlerow": true
                                },
                                "depends": {
                                    "booldependson": "savedaytimeimages OR savenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsestart": {
                            "default": "",
                            "description": "Only use images taken at or after this time in the timelapse.<br>Leave empty to use the first image of the day.  Enter a time like <code>18:00</code> or one of <code>sunrise</code>, <code>sunset</code>, <code>daytime_start</code>, <code>daytime_end</code>, <code>nighttime_start</code>, or <code>nighttime_end</code>.",
                            "label": "Start Time",
                            "label_prefix": "Daily Timelapse",
                            "type": "starttime",
                            "endfield": "timelapseend",
                            "carryforward": true,
                            "optional": true,
                            "checkchanges": true,
                            "metadata": {
                                "layout": {
                                    "group": "timelapsetime",
                                    "groupname": "Timelapse Times"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapseend": {
                            "default": "",
                            "description": "Only use images taken at or before this time in the timelapse.<br>Leave empty to use the last image of the day.  Enter a time like <code>06:00</code> or one of <code>sunrise</code>, <code>sunset</code>, <code>daytime_start</code>, <code>daytime_end</code>, <code>nighttime_start</code>, or <code>nighttime_end</code>.<br>An end time earlier than the start time is on the next day, so <code>18:00</code> to <code>06:00</code> works.",
                            "label": "End Time",
                            "label_prefix": "Daily Timelapse",
                            "type": "endtime",
                            "startfield": "timelapsestart",
                            "carryforward": true,
                            "optional": true,
                            "checkchanges": true,
                            "metadata": {
                                "layout": {
                                    "group": "timelapsetime"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsefps": {
                            "minimum": 1,
                            "maximum": 200,
                            "default": 25,
                            "description": "Frames Per Second (FPS) of timelapse video.  Higher values will produce smoother, but faster videos.",
                            "label": "FPS",
                            "label_prefix": "Daily Timelapse",
                            "type": "integer",
                            "carryforward": true,
                            "step": "1",
                            "unit": "fps",
                            "metadata": {
                                "layout": {
                                    "group": "timelapsevideo",
                                    "groupname": "Timelapse Video Format"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsebitrate": {
                            "minimum": 100,
                            "maximum": 30000,
                            "default": 5000,
                            "description": "Bitrate (in K) of timelapse video. Higher values produce higher quality but larger files. Do NOT add <code>k</code>.",
                            "label": "Bitrate",
                            "label_prefix": "Daily Timelapse",
                            "type": "integer",
                            "step": "1",
                            "unit": "kbit/s",
                            "metadata": {
                                "layout": {
                                    "group": "timelapsevideo"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsewidth": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Width of resized timelapse video. <span class='WebUIValue'>0</span> disables resize.  Must be an even number.",
                            "label": "Width",
                            "label_prefix": "Daily Timelapse",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "layout": {
                                    "group": "timelapseresize",
                                    "groupname": "Timelapse Resize"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapseheight": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Height of resized timelapse video. <span class='WebUIValue'>0</span> disables resize.  Must be an even number.",
                            "label": "Height",
                            "label_prefix": "Daily Timelapse",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "layout": {
                                    "group": "timelapseresize"
                                },
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsekeepsequence": {
                            "default": false,
                            "description": "Use for debugging purposes only.  Enable to keep the list of files used in creating the timelapse video.",
                            "label": "Keep Sequence",
                            "label_prefix": "Daily Timelapse",
                            "type": "boolean",
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapseextraparameters": {
                            "default": "",
                            "description": "Optional additional timelapse creation parameters.  Run <code>ffmpeg -?</code> to see the options.<br>If quality is poor or the video does not play on Apple devices, try adding <code>-level 3.1</code>.",
                            "label": "Extra Parameters",
                            "label_prefix": "Daily Timelapse",
                            "type": "widetext",
                            "carryforward": true,
                            "optional": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        }
                    }
                },
                "minitimelapse": {
                    "label": "Mini",
                    "settings": {
                        "minitimelapsenumimages": {
                            "minimum": 0,
                            "maximum": "none",
                            "default": 0,
                            "description": "Number of images in a mini-timelapse. <span class='WebUIValue'>0</span> disables mini-timelapse creation.",
                            "label": "Number Of Images",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "carryforward": true,
                            "checkchanges": true,
                            "step": "1",
                            "unit": "images",
                            "metadata": {
                                "depends": {
                                    "booldependson": "savedaytimeimages OR savenighttimeimages"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapseforcecreation": {
                            "default": false,
                            "description": "Create a mini-timelapse even if <span class='WebUISetting'>Number Of Images</span> isn't reached?",
                            "label": "Force Creation",
                            "label_prefix": "Mini-Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapsefrequency": {
                            "minimum": 1,
                            "maximum": "none",
                            "default": 5,
                            "description": "Make a mini-timelapse every X images.<br>If you have a slow Pi or short delays between images, set this to a higher number (i.e., not as often).",
                            "label": "Frequency",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "carryforward": true,
                            "step": "1",
                            "unit": "images",
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapsewidth": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Width of resized mini-timelapse video. <span class='WebUIValue'>0</span> disables resize.  Must be an even number.",
                            "label": "Width",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapseheight": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Height of resized mini-timelapse video. <span class='WebUIValue'>0</span> disables resize.  Must be an even number.",
                            "label": "Height",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapsebitrate": {
                            "minimum": 100,
                            "maximum": 30000,
                            "default": 2000,
                            "description": "Bitrate (in K) of timelapse video. Higher values produce higher quality but larger files. Do NOT add <code>k</code>.",
                            "label": "Bitrate",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "carryforward": true,
                            "step": "1",
                            "unit": "kbit/s",
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        },
                        "minitimelapsefps": {
                            "minimum": 1,
                            "maximum": 200,
                            "default": 5,
                            "description": "Frames Per Second (FPS) of mini-timelapse video.",
                            "label": "FPS",
                            "label_prefix": "Mini-Timelapse",
                            "type": "integer",
                            "carryforward": true,
                            "step": "1",
                            "unit": "fps",
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "advanced"
                            }
                        }
                    }
                },
                "timelapsebothsub": {
                    "label": "Both",
                    "settings": {
                        "timelapsevcodec": {
                            "default": "libx264",
                            "description": "Video encoder for timelapse.  Rarely changed.",
                            "label": "VCODEC",
                            "label_prefix": "Timelapse",
                            "type": "vcodec",
                            "carryforward": true,
                            "checkchanges": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsepixfmt": {
                            "default": "yuv420p",
                            "description": "Pixel format for timelapse.  Rarely changed.",
                            "label": "Pixel format",
                            "label_prefix": "Timelapse",
                            "type": "pixfmt",
                            "carryforward": true,
                            "checkchanges": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        },
                        "timelapsefflog": {
                            "default": "warning",
                            "description": "Amount of information to display while creating a timelapse.  Rarely changed.",
                            "label": "Log Level",
                            "label_prefix": "Timelapse",
                            "type": "select_text",
                            "carryforward": true,
                            "options": [
                                {
                                    "value": "quiet",
                                    "label": "No output"
                                },
                                {
                                    "value": "fatal",
                                    "label": "Fatal Errors"
                                },
                                {
                                    "value": "error",
                                    "label": "Errors"
                                },
                                {
                                    "value": "warning",
                                    "label": "Warnings + Errors"
                                },
                                {
                                    "value": "info",
                                    "label": "Info + Warnings + Errors"
                                }
                            ],
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "advanced"
                            }
                        }
                    }
                }
            },
            "label": "Timelapses"
        },
        "keograms": {
