                "startrailsend": {
                    "default": "",
                    "description": "Only use images taken at or before this time in the startrails.<br>Leave empty to use the last image of the day.  Enter a time like <code>06:00</code> or one of <code>sunrise</code>, <code>sunset</code>, <code>daytime_start</code>, <code>daytime_end</code>, <code>nighttime_start</code>, or <code>nighttime_end</code>.<br>An end time earlier than the start time is on the next day, so <code>18:00</code> to <code>06:00</code> works.",
                    "label": "End Time",
                    "label_prefix": "Startrails",
                    "type": "endtime",
                    "startfield": "startrailsstart",
                    "carryforward": true,
                    "optional": true,
                    "checkchanges": true,
                    "metadata": {
                        "layout": {
                            "group": "startrailtime"
                        },
                        "depends": {
                            "booldependson": "startrailsgenerate"
                        },
                        "level": "advanced"
                    }
                },
                "startrailsbrightnessthreshold": {
                    "minimum": 0.0,
                    "maximum": 1.0,
                    "default": 0.1,
                    "description": "Images with a brightness higher than this threshold will not be included in the startrails.",
                    "label": "Brightness Threshold",
                    "label_prefix": "Startrails",
                    "type": "float",
                    "step": "0.01",
                    "metadata": {
                        "depends": {
                            "booldependson": "startrailsgenerate"
                        },
                        "level": "advanced"
                    }
                },
                "startrailsextraparameters": {
                    "default": "",
                    "description": "Optional additional startrails creation parameters.<br>Run <code>~/allsky/bin/startrails --help</code> for a list of options.",
                    "label": "Extra Parameters",
                    "label_prefix": "Startrails",
                    "type": "widetext",
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "startrailsgenerate"
                        },
                        "level": "advanced"
                    }
                }
            }
        },
        "website": {
            "sections": {
                "general": {
                    "label": "General",
                    "settings": {
                        "imageresizeuploadswidth": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Resized width of uploaded images. <span class='WebUIValue'>0</span> means don't resize.  Must be an even number.",
                            "label": "Resize Uploaded Images Width",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "depends": {
                                    "booldependson": "imageuploadfrequency"
                                },
                                "level": "beginner"
                            }
                        },
                        "imageresizeuploadsheight": {
                            "minimum": 0,
                            "maximum": "_max",
                            "default": 0,
                            "description": "Resized height of uploaded images. <span class='WebUIValue'>0</span> means don't resize.  Must be an even number.",
                            "label": "Resize Uploaded Images Height",
                            "type": "integer",
                            "checkchanges": true,
                            "step": "1",
                            "unit": "px",
                            "metadata": {
                                "depends": {
                                    "booldependson": "imageuploadfrequency"
                                },
                                "level": "beginner"
                            }
                        },
                        "imageuploadfrequency": {
                            "minimum": 0,
                            "maximum": "none",
                            "default": 1,
                            "description": "How often should images be uploaded to an Allsky Website and/or remote server?<br><span class='WebUIValue'>0</span> never uploads images, <span class='WebUIValue'>1</span> uploads every frame, <span class='WebUIValue'>2</span> every other frame, etc.",
                            "label": "Upload Every X Images",
                            "type": "integer",
                            "carryforward": true,
                            "step": "1",
                            "unit": "images",
                            "metadata": {
                                "depends": {
                                    "booldependson": "uselocalwebsite OR useremotewebsite OR useremoteserver"
                                },
                                "level": "beginner"
                            }
                        },
                        "timelapseupload": {
                            "default": true,
                            "description": "Enable to upload the timelapse video to an Allsky Website and/or remote server.",
                            "label": "Upload Timelapse",
                            "label_prefix": "Daily Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate"
                                },
                                "level": "beginner"
                            }
                        },
                        "timelapseuploadthumbnail": {
                            "default": true,
                            "description": "Enable to upload the timelapse video thumbnail.",
                            "label": "Upload Timelapse Thumbnail",
                            "label_prefix": "Daily Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "timelapsegenerate AND timelapseupload"
                                },
                                "level": "beginner"
                            }
                        },
                        "keogramupload": {
                            "default": true,
                            "description": "Enable to upload the keogram to an Allsky Website and/or remote server.",
                            "label": "Upload Keogram",
                            "label_prefix": "Keograms",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "keogramgenerate"
                                },
                                "level": "beginner"
                            }
                        },
                        "startrailsupload": {
                            "default": true,
                            "description": "Enable to upload the startrails to an Allsky Website and/or remote server.",
                            "label": "Upload Startrails",
                            "label_prefix": "Startrails",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "startrailsgenerate"
                                },
                                "level": "beginner"
                            }
                        },
                        "minitimelapseupload": {
                            "default": false,
                            "description": "Enable to upload the mini-timelapse video to an Allsky Website and/or remote server.",
                            "label": "Upload Mini-Timelapse",
                            "label_prefix": "Mini-Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "beginner"
                            }
                        },
                        "minitimelapseuploadthumbnail": {
                            "default": true,
                            "description": "Enable to upload the mini-timelapse video thumbnail.",
                            "label": "Upload Mini-Timelapse Thumbnail",
                            "label_prefix": "Mini-Timelapse",
                            "type": "boolean",
                            "carryforward": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "minitimelapseupload",
                                    "valuedependson": "minitimelapsenumimages=[1-9]*"
                                },
                                "level": "beginner"
                            }
                        },
                        "displaysettings": {
                            "default": false,
                            "description": "Enable to add a link on the Allsky Website to display the settings on this page.",
                            "label": "Display Settings",
                            "type": "boolean",
                            "carryforward": true,
                            "checkchanges": true,
                            "metadata": {
                                "depends": {
                                    "booldependson": "uselocalwebsite OR useremotewebsite OR useremoteserver"
                                },
                                "level": "beginner"
                            }
                        }
                    }
                },
                "localwebsite": {
                    "label": "Local Website",
                    "settings": {
                        "uselocalwebsite": {
                            "description": "Enable to use the local Allsky Website.<br>You should configure it in the <span class='WebUILink'>Editor</span> page first.",
                            "default": false,
                            "label": "Use Local Website",
                            "type": "boolean",
                            "carryforward": true,
                            "checkchanges": true,
                            "popup-yesno": "Do you want to remove all saved images, keograms, startrails, and videos in the local Website?",
                            "popup-yesno-value": 0,
                            "metadata": {
                                "layout": {
                                    "singlerow": true
                                },
                                "level": "beginner"
                            }
                        },
                        "daystokeeplocalwebsite": {
                            "minimum": 0,
                            "maximum": "none",
                            "default": 0,
                            "description": "Number of days of images and videos to keep on the Pi's Website. <span class='WebUIValue'>0</span> keeps all days.",
                            "label": "Days To Keep on Pi Website",
                            "type": "integer",
