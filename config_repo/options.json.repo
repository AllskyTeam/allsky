        "allskymap": {
            "label": "Map",
            "settings": {
                "showonmap": {
                    "default": false,
                    "description": "Enable to have your camera appear on the <a href='https://www.thomasjacquin.com/allsky-map/' target='_blank' title='Opens in new tab/window'><span class='WebUISetting'>Allsky Map <i class='fa fa-external-link-alt fa-fw'></i></span></a>.",
                    "label": "Show on Map",
                    "type": "boolean",
                    "carryforward": true,
                    "checkchanges": true,
                    "metadata": {
                        "layout": {
                            "singlerow": true
                        },
                        "level": "advanced"
                    }
                },
                "location": {
                    "default": "",
                    "description": "The location of your camera, for example: Whitehorse, YT.<br>This setting and the remaining ones also appear on the Allsky Website, if installed.",
                    "label": "Location",
                    "type": "widetext",
                    "carryforward": true,
                    "checkchanges": true,
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "showonmap"
                        },
                        "level": "advanced"
                    }
                },
                "owner": {
                    "default": "",
                    "description": "The owner of the camera. It can be your name, an association, or observatory, etc.",
                    "label": "Owner",
                    "type": "text",
                    "carryforward": true,
                    "checkchanges": true,
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "showonmap"
                        },
                        "level": "advanced"
                    }
                },
                "camera": {
                    "settingsonly": true,
                    "default": "",
                    "description": "The type and model of your camera. Set automatically.",
                    "label": "NOT DISPLAYED IN WebUI",
                    "type": "text",
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "lens": {
                    "default": "",
                    "description": "The lens you're using on your camera, for example: <span class='WebUIValue'>Arecont 1.55 mm</span>.",
                    "label": "Lens",
                    "type": "text",
                    "checkchanges": true,
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "showonmap"
                        },
                        "level": "advanced"
                    }
                },
                "computer": {
                    "settingsonly": true,
                    "default": "",
                    "description": "The computer running your allsky camera. Set automatically.",
                    "label": "NOT DISPLAYED IN WebUI",
                    "type": "text",
                    "carryforward": true,
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "equipmentinfo": {
                    "default": "",
                    "description": "Optional information on your equipment.",
                    "label": "Equipment Info",
                    "type": "widetext",
                    "checkchanges": true,
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "showonmap"
                        },
                        "level": "advanced"
                    }
                }
            }
        },
        "webui": {
            "label": "WebUI",
            "settings": {
                "imagessortorder": {
                    "default": "ascending",
                    "description": "The order the images on the <span class='WebUIWebPage'>Images</span> page are sorted in.<br><strong>Ascending</strong> is oldest to newest. <strong>Descending</strong> is newest to oldest.",
                    "label": "Images Sort Order",
                    "type": "select_text",
                    "carryforward": true,
                    "options": [
                        {
                            "value": "ascending",
                            "label": "Ascending"
                        },
                        {
                            "value": "descending",
                            "label": "Descending"
                        }
                    ],
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "showupdatedmessage": {
                    "default": true,
                    "description": "Disable to hide the <span class='alert-info'>Daytime images updated every...</span> message in the <span class='WebUIWebPage'>Live View</span> page.",
                    "label": "Show Updated Message",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "uselogin": {
                    "default": false,
                    "description": "Determines if you need to login to the WebUI or not.<br><b>If your Pi is accessible on the Internet, do NOT turn this off!!</b>.",
                    "label": "Require WebUI Login",
                    "type": "boolean",
                    "checkchanges": true,
                    "carryforward": true,
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "liveviewmode": {
                    "default": "fullwidth",
                    "description": "Controls how the image is displayed on the <span class='WebUIWebPage'>Live View</span> page.<br><strong>Full Width</strong> always fills the panel width and may require vertical scrolling.<br><strong>Fit Image</strong> keeps the whole image visible in the panel without a vertical scrollbar.",
                    "label": "Live View Mode",
                    "type": "select_text",
                    "carryforward": true,
                    "options": [
                        {
                            "value": "fullwidth",
                            "label": "Full Width"
                        },
                        {
                            "value": "scaled",
                            "label": "Fit Image"
                        }
                    ],
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "inlinemessages": {
                    "default": true,
                    "description": "If enabled system messages are shown at the top of the page rather than via the menu.",
                    "label": "Inline System Messages",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "fieldhelpdelay": {
                    "minimum": 0,
                    "maximum": 60000,
                    "default": 500,
                    "description": "Milliseconds to wait before showing field help. Set to 0 to require a click.",
                    "label": "Field Help Delay",
                    "type": "integer",
                    "carryforward": true,
                    "step": "1",
                    "unit": "ms",
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "settingslevel": {
                    "default": "advanced",
                    "description": "Choose which settings are shown. Beginner shows the essentials, Intermediate also shows intermediate settings, and Advanced shows everything. The page updates immediately; save settings to keep this preference.",
                    "label": "Settings Level",
                    "type": "select_text",
                    "carryforward": true,
                    "options": [
                        {
                            "value": "beginner",
                            "label": "Beginner"
                        },
                        {
                            "value": "intermediate",
                            "label": "Intermediate"
                        },
                        {
                            "value": "advanced",
                            "label": "Advanced"
                        }
                    ],
                    "metadata": {
                        "level": "beginner",
                        "layout": {
                            "group": "settingsfields",
                            "groupname": "Settings Fields",
                            "singlerow": true
                        }
                    }
                },
                "settingsdependencies": {
                    "default": true,
                    "description": "Enable or disable settings fields based on their dependency values. Changes take effect immediately; save settings to keep this preference.",
                    "label": "Use Field Dependencies",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "layout": {
                            "group": "settingsfields"
                        },
                        "level": "advanced"
                    }
                },
                "settingsgroups": {
                    "default": true,
                    "description": "Display settings fields with the same group in a shared panel. Changes take effect immediately; save settings to keep this preference.",
                    "label": "Use Field Groups",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "layout": {
                            "group": "settingsfields"
                        },
                        "level": "advanced"
                    }
                },
                "settingspopupbuttons": {
                    "default": true,
                    "description": "Show buttons that open the video format, time, location, and locale pickers. Changes take effect immediately; save settings to keep this preference.",
                    "label": "Show Picker Buttons",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "layout": {
                            "group": "settingsfields"
                        },
                        "level": "advanced"
                    }
                },
                "settingsshowallbydefault": {
                    "default": false,
                    "description": "Open the settings page showing all settings. Changes take effect immediately; save settings to keep this preference.",
                    "label": "Show All Settings by Default",
                    "type": "boolean",
                    "carryforward": true,
                    "metadata": {
                        "layout": {
                            "group": "settingsfields"
                        },
                        "level": "advanced"
                    }
                },
                "webuidatafiles": {
                    "default": "",
                    "description": "See the documentation for a <a external='true' href='/docs/allsky_guide/settings/allsky.html#WebUI-settings'>description of this setting</a>.",
                    "label": "System Page Additions",
                    "type": "systemadditions",
                    "carryforward": true,
                    "optional": true,
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "daytimeoverlay": {
                    "settingsonly": true,
                    "default": "",
                    "description": "The overlay file to use during daytime",
                    "label": "NOT DISPLAYED IN WebUI",
                    "type": "text",
                    "metadata": {
                        "level": "advanced"
                    }
                },
                "nighttimeoverlay": {
                    "settingsonly": true,
                    "default": "",
                    "description": "The overlay file to use during nighttime",
                    "label": "NOT DISPLAYED IN WebUI",
                    "type": "text",
                    "metadata": {
                        "level": "advanced"
                    }
                }
            }
        },
        "databasesettings": {
            "label": "Allsky Database",
            "warning": "Only change these settings if you know what you are doing.",
            "settings": {
                "enabledatabase": {
                    "default": true,
                    "description": "Enable the Allsky database.<br>Many new features will not work if the database is disabled.",
                    "label": "Enable Database",
                    "type": "boolean",
                    "carryforward": true,
                    "checkchanges": true,
                    "metadata": {
                        "layout": {
                            "singlerow": true
                        },
                        "level": "advanced"
                    }
                },
                "databasedatabase": {
                    "default": "allsky",
                    "description": "The name of the database to use.",
                    "label": "Database",
                    "type": "text",
                    "carryforward": true,
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "enabledatabase"
                        },
                        "level": "advanced"
                    }
                },
                "databasetype": {
                    "default": "sqlite",
                    "description": "The type of database.<br>MySQL has more features but uses a lot more CPU and memory.",
                    "label": "Database Type",
                    "type": "select_text",
                    "carryforward": true,
                    "options": [
                        {
                            "value": "sqlite",
                            "label": "SQLite"
                        },
                        {
                            "value": "mysql",
                            "label": "MySQL"
                        }
                    ],
                    "optional": true,
                    "metadata": {
                        "depends": {
                            "booldependson": "enabledatabase"
                        },
                        "level": "advanced"
                    }
                },
                "databasehost": {
                    "default": "",
                    "description": "(MySQL only) The IP address or hostname of the server running the database.<br>By default the database runs on your Pi.",
                    "label": "Database Host",
                    "type": "text",
                    "carryforward": true,
                    "optional": true,
                    "source": "${ALLSKY_ENV}",
                    "metadata": {
                        "layout": {
                            "group": "mysqldatabse",
                            "groupname": "MySQL Database Settings"
                        },
                        "depends": {
                            "booldependson": "enabledatabase",
                            "valuedependson": "databasetype=mysql"
                        },
                        "level": "advanced"
                    }
                },
                "databaseuser": {
                    "default": "",
                    "description": "(MySQL only) The username used to connect to the database.",
                    "label": "Database User",
                    "type": "text",
                    "carryforward": true,
                    "optional": true,
                    "source": "${ALLSKY_ENV}",
                    "metadata": {
                        "layout": {
                            "group": "mysqldatabse"
                        },
                        "depends": {
                            "booldependson": "enabledatabase",
                            "valuedependson": "databasetype=mysql"
                        },
                        "level": "advanced"
                    }
                },
                "databasepassword": {
                    "default": "",
                    "description": "(MySQL only) The password used to connect to the database.",
                    "label": "User Password",
                    "type": "text",
                    "carryforward": true,
                    "optional": true,
                    "source": "${ALLSKY_ENV}",
                    "metadata": {
                        "layout": {
                            "group": "mysqldatabse"
                        },
                        "depends": {
                            "booldependson": "enabledatabase",
                            "valuedependson": "databasetype=mysql"
                        },
                        "level": "advanced"
                    }
                }
            }
        },
