<div class="settings-timeformat-picker">
    {% include 'controls/text-input.html.twig' with {
        row: row, input_class: 'settingInput settingInputTextNumber js-timeformat-input',
        input_type: 'text', autocomplete: 'off', spellcheck: 'false'
    } only %}
    <button class="btn btn-default js-timeformat-open" type="button" aria-label="Choose {{ row.label }}" title="Build date and time format"{% if row.dependency.disabled or row.dependency.readonly %} disabled{% endif %}><i class="fa-regular fa-calendar-days" aria-hidden="true"></i></button>
</div>
